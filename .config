# SD card mux device for sdcardmux.sh
export SDCARDMUX_DEVICE="/dev/sg0"

# IP or hostname of Shelly device for Shelly scripts
export SHELLY_HOST="10.10.5.20"

# Debug console tty device, normally something like
# /dev/ttyUSB0. 
export DEBUUG_CONSOLE="/dev/ttyUSB0"

# Auxiliary Core UART
export AUX_CORE_UART="/dev/ttyUSB0"

# Camera device for services/camera-server.py
export CAMERA_SERVER_DEV="/dev/video3"
